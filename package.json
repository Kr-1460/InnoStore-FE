{
  "name": "inno-store-fe",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:InnoStore-FE": "node dist/InnoStore-FE/server/server.mjs",
    "generate:api": "ng-openapi -c openapi.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.5.1",
    "@angular/cdk": "~21.1.4",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.0",
    "@auth0/auth0-angular": "^2.6.0",
    "@ng-select/ng-select": "^21.2.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "auth0": "^5.3.0",
    "express": "^5.1.0",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@openapitools/openapi-generator-cli": "^2.28.0",
    "@types/express": "^5.0.1",
    "google-one-tap": "^1.0.6",
    "jsdom": "^27.1.0",
    "ng-openapi": "^0.2.14",
    "ng-openapi-gen": "^1.0.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
